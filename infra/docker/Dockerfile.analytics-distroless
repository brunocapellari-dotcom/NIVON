# NIVON EXPERIMENTAL: distroless Debian 13 + CPython 3.11 from image already locked.
# The base is injected as a VERIFIED, immutable multiarchitecture digest by CI.
# Never release without full CVE/ABI audit. No network, shell or package manager in runtime.
ARG DISTROLESS_BASE=gcr.io/distroless/cc-debian13@sha256:83b9b50586253821cf63ffcec87d3d94265a093ad30da232039af962dd8f4edf
FROM nivon-analytics:ci AS analytics-source
# Minimal explicit SONAME shown missing by BOTH native runners.
# Do not copy /usr/lib wholesale: each added ABI library must have
# independent runtime proof and CVE re-scan.
FROM nivon-analytics:ci AS sqlite3-runtime-libs
# Root somente no estágio de cópia do build; runtime final é 65532.
USER 0:0
ARG TARGETARCH
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) triplet=x86_64-linux-gnu ;; \
      arm64) triplet=aarch64-linux-gnu ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    mkdir -p "/runtime-libs/usr/lib/$triplet"; \
    test -r "/usr/lib/$triplet/libsqlite3.so.0"; \
    cp -L "/usr/lib/$triplet/libsqlite3.so.0" "/runtime-libs/usr/lib/$triplet/libsqlite3.so.0"
FROM ${DISTROLESS_BASE} AS analytics-distroless-candidate
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/opt/nivon/deps \
    NUMBA_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1
WORKDIR /app
COPY --from=sqlite3-runtime-libs /runtime-libs/usr/lib/ /usr/lib/
COPY --from=analytics-source /usr/local/ /usr/local/
COPY --from=analytics-source /opt/nivon/deps/ /opt/nivon/deps/
COPY --from=analytics-source /app/ /app/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/python", "-m", "nivon.infra_analytics_probe"]
CMD ["--offline-synthetic"]

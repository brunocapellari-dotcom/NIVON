# Worker mínimo para validação ARM64/amd64 — NÃO É RELEASE DE PRODUÇÃO.
# Base deve ser fixada por digest após auditoria de supply chain.
# Não instala pacotes de fontes, chaves, rede, schedulers nem clientes externos.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src
WORKDIR /app
COPY src/ /app/src/
COPY config/ /app/config/
COPY infra/inventory.v1.json /app/infra/inventory.v1.json
USER 65532:65532
ENTRYPOINT ["python", "-m", "nivon.infra_worker"]
CMD ["--mode", "self-check"]

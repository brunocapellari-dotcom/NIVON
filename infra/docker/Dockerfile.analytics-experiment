# NIVON: somente imagem ANALÍTICA EXPERIMENTAL, sem ativação/cloud/release.
# Primeiro estágio instala SOMENTE wheels baixadas previamente, sem rede no build.
# Named build-context "wheelhouse" é obrigatório: nenhuma roda é baixada pelo Dockerfile.
FROM python:3.11-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8 AS analytics-deps
WORKDIR /tmp
COPY --from=wheelhouse / /tmp/wheels/
RUN python -m pip install --no-index --only-binary=:all: --no-cache-dir --no-compile \
      --find-links=/tmp/wheels --target=/opt/nivon/deps \
      "agrobr==2.0.0" "pandas>=2.2,<3" "statsforecast>=2,<3"

FROM python:3.11-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8 AS analytics-experiment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/opt/nivon/deps \
    NUMBA_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1
WORKDIR /app
COPY --from=analytics-deps /opt/nivon/deps/ /opt/nivon/deps/
RUN python -m pip uninstall --yes wheel jaraco.context setuptools && \
    python -m pip uninstall --yes pip
COPY src/ /app/src/
COPY config/ /app/config/
COPY infra/inventory.v1.json /app/infra/inventory.v1.json
USER 65532:65532
ENTRYPOINT ["python", "-m", "nivon.infra_analytics_probe"]
CMD ["--offline-synthetic"]

# CANDIDATO EXPERIMENTAL: Python 3.11.17 / Alpine 3.23, musl, AMD64/ARM64.
# Não é release; não substituir a base Debian sem auditoria de compatibilidade.
# Digest multiarch verificado no Docker Hub em 21/10/2026.
FROM python:3.11.17-alpine3.23@sha256:924d53e01cee5204d35fbcfb71b6c1568c857d7c31141f960ff6a37e111ecc7f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src
WORKDIR /app
# O worker atual executa apenas stdlib; nenhum pip necessário no runtime.
# As remoções ocorrem sem baixar pacotes ou acessar índices externos.
RUN python -m pip uninstall --yes wheel jaraco.context setuptools && \
    python -m pip uninstall --yes pip
COPY src/ /app/src/
COPY config/ /app/config/
COPY infra/inventory.v1.json /app/infra/inventory.v1.json
USER 65532:65532
ENTRYPOINT ["python", "-m", "nivon.infra_worker"]
CMD ["--mode", "self-check"]

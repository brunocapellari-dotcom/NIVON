# EXEMPLO DOCUMENTAL. NÃO carregar este arquivo em produção.
# O compose de auditoria não utiliza credenciais nem variáveis de rede.
NIVON_ENV=development
NIVON_RUNTIME_ENABLED=false
NIVON_DATA_ROOT=/var/lib/nivon
NIVON_BACKUP_ROOT=/var/backups/nivon
NIVON_PROVIDER_CANDIDATE=ORACLE_CLOUD_ALWAYS_FREE
NIVON_PAID_SERVICES_ALLOWED=false

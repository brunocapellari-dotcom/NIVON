# Cloud Run Job nivon-coletor: PTAX, ANTT ferroviário, CONAB e marítimo.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/src
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY scripts ./scripts
RUN python -m pip install --no-cache-dir '.[gcp,excel]'
USER 65532:65532
CMD ["python","-m","nivon.carga.coletor"]
